<Page x:Class="Практическаяработа2.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическаяработа2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Background="#FFE9CACA" >
        
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="250">

            <TextBlock 
                Text="Вариант №10"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,18"/>

            <Button
                x:Name="btnTask1"
                Content="Задание 1"
                Width="250"
                Height="55"
                FontSize="18"
                Margin="0,0,0,18"
                Click="Task1Button_Click"
                Background="#FFBAA7DF"
                />



            <Button
                x:Name="btnTask2"
                Content="Задание 2"
                Width="250"
                Height="55"
                FontSize="18"
                Margin="0,0,0,18"
                Click="Task2Button_Click"
                Background="#FFBAA7DF"/>
            <Button 
               x:Name="btnTask3"
                Content="Задания 3"
                Width="250"
                Height="55"
                FontSize="18"
                Margin="0,0,0,18"
               Background="#FFBAA7DF"
                Click="Task3Button_Click"/>
            <Button
                x:Name="btnTask4"
                Content="Задание 4"
                Width="250"
                Height="50"
                FontSize="18"
                
                Click="Task4Button_Click"
                Margin="0,0,0,18"
                Background="#FFBAA7DF"/>

            <Button
                x:Name="btnTask5"
                Content="Задание 5"
                Width="250"
                Height="50"
                FontSize="18"
                Click="Task5Button_Click"
                Background="#FFBAA7DF"/>
        </StackPanel>


    </Grid>
</Page>
