<Page x:Class="Практическаяработа2.Pages.Task4Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическаяработа2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task4Page">

    <Grid Margin="20"
          Background="#FFE9CACA">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Условие -->

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">

            <Run Text="Задание 1. " FontWeight="Bold"/>
            <Run Text="Дан целочисленный массив A размера N. Вывести номер первого из тех его элементов A[i], которые удовлетворяют двойному неравенству: A[1] &lt; A[i] &lt; A[10]. Если таких элементов нет, вывести 0."/>

        </TextBlock>

        <!-- Размер массива -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock Text="Размер массива N:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="txtN"
                     Width="80"
                     Height="25"
                     Text="15"
                     Background="#FFBAA7DF"
                     VerticalContentAlignment="Center"/>

        </StackPanel>

        <!-- Исходный массив -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <TextBlock Text="Массив:"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="txtArray"
                     Width="550"
                     Height="30"
                     IsReadOnly="True"
                     Background="#FFBAA7DF"
                     VerticalContentAlignment="Center"/>

        </StackPanel>

        <!-- Кнопки -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Button Content="Сгенерировать"
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="btnGenerate_Click"
                    Background="#FFBAA7DF"/>

            <Button Content="Выполнить"
                    Width="120"
                    Height="30"
                    Click="btnExecute_Click"
                    Background="#FFBAA7DF"/>

        </StackPanel>

        <!-- Результат -->

        <TextBlock x:Name="txtResult"
                   Grid.Row="4"
                   FontSize="15"
                   FontWeight="Bold"
                   Margin="0,15,0,0"/>


    </Grid>
</Page>
