<Page x:Class="Практическаяработа2.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Практическаяработа2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1Page">

    <Grid Margin="20" Background="#FFE9CACA">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50" MinHeight="50"/>
            <RowDefinition Height="55" MinHeight="55"/>
            <RowDefinition Height="60" MinHeight="6.04"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Height="18" Width="638">
    <Run Text="Задача 1." FontWeight="Bold"/>
    <Run Text="Дано число. Вывести цифры, которые повторяются в записи числа больше одного раза."/>
        </TextBlock>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Исходные данные:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtInput" Width="200" Height="25" 
             VerticalContentAlignment="Center" Background="#FFBAA7DF"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Выходные данные:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtResult" Width="300" Height="25" 
             IsReadOnly="True" VerticalContentAlignment="Center"
             Background="#FFBAA7DF"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnGenerate" Content="Сгенерировать" Width="120" Height="30" 
            Margin="0,0,10,0" Click="btnGenerate_Click" Background="#FFBAA7DF"/>
            <Button x:Name="btnExecute" Content="Выполнить" Width="120" Height="30" 
            Click="btnExecute_Click" Background="#FFBAA7DF"/>
        </StackPanel>
        <TextBlock x:Name="txtError" Grid.Row="3" Foreground="Red" 
           FontSize="12" Margin="0,111,0,4"/>
    </Grid>
</Page>
